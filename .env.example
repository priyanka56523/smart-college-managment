# Global AI & AGI News Intelligence Platform Configuration
# Copy this file to .env and configure your keys. Never commit real keys to source control.

# Application Settings
ENVIRONMENT=development
DEBUG=True

# Database URL (Default: local SQLite database; PostgreSQL format: postgresql://user:password@localhost:5432/ai_intel)
DATABASE_URL=sqlite:///./ai_news_intelligence.db

# NewsAPI Integration (https://newsapi.org/docs)
# Optional for local prototype: when omitted, platform uses arXiv, GitHub, and official feeds
NEWSAPI_API_KEY=your_newsapi_key_here
NEWSAPI_BASE_URL=https://newsapi.org/v2

# NVIDIA Hosted LLM API (https://build.nvidia.com/)
# Optional for local prototype: when omitted, platform uses deterministic heuristic extraction engine
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Background Scheduler & Ingestion
SCHEDULER_ENABLED=True
SCHEDULER_INTERVAL_HOURS=6
MAX_ARTICLES_PER_RUN=40
REQUEST_TIMEOUT_SECONDS=15
